# Fifine AmpliGame D6 / Mirabox Stream Dock (USB 3142:0060).
# Grants the local user the vendor HID interface. Replace OWNER with your user,
# or drop OWNER and rely on TAG+="uaccess" if your logind assigns it on hotplug.
SUBSYSTEM=="usb",    ATTRS{idVendor}=="3142", ATTRS{idProduct}=="0060", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3142", ATTRS{idProduct}=="0060", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input",  ATTRS{idVendor}=="3142", ATTRS{idProduct}=="0060", MODE="0660", TAG+="uaccess"
