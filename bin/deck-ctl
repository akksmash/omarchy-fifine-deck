#!/usr/bin/env python3
"""Control and inspect the deck.

    deck-ctl status          human-readable state
    deck-ctl status --json   one JSON line (what the bar widget reads)
    deck-ctl redraw          ask the daemon to redraw the icons
    deck-ctl reload          restart the daemon (picks up a hand-edited config)
    deck-ctl probe           list attached HID devices and whether we know them
    deck-ctl install         install permissions + autostart for this OS

`redraw` deliberately goes through the daemon rather than opening the device:
this hardware stops accepting images after a limited volume of writes, and two
processes drawing at once wastes that budget for no gain.
"""
import argparse
import json
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))

from deck import config, platforms, render, transport       # noqa: E402
from deck.devices import DEVICES, find_profile              # noqa: E402
from deck.drivers import discover                           # noqa: E402
from deck.paths import CACHE_DIR, CONFIG_FILE, ensure_dirs  # noqa: E402

TRIGGER = os.path.join(CACHE_DIR, "redraw.trigger")


def state() -> dict:
    plat = platforms.current()
    found = discover()
    keys = config.load()
    return {
        "present": bool(found),
        "device": found[0][0].name if found else None,
        "daemon": "active" if plat.daemon_running() else "inactive",
        "keys": len(keys),
        "backend": transport.backend_name(),
        "magick": render.have_magick(),
    }


def cmd_status(args) -> int:
    st = state()
    if args.json:
        print(json.dumps(st, separators=(",", ":")))
        return 0
    print(f"device   {st['device'] or 'not connected'}")
    print(f"daemon   {st['daemon']}")
    print(f"keys     {st['keys']} bound  ({CONFIG_FILE})")
    print(f"backend  {st['backend']}")
    if not st["magick"]:
        print("warning  ImageMagick not found; icons cannot be rendered")
    for n in platforms.current().notes():
        print(f"note     {n}")
    return 0 if st["present"] else 1


def cmd_redraw(args) -> int:
    ensure_dirs()
    with open(TRIGGER, "w") as f:
        f.write(str(time.time()))
    plat = platforms.current()
    if not plat.daemon_running():
        print("daemon is not running; start it with: deck-ctl reload",
              file=sys.stderr)
        return 1
    print("redraw requested")
    return 0


def cmd_reload(args) -> int:
    ok, msg = platforms.current().reload_daemon()
    print(msg)
    return 0 if ok else 1


def cmd_probe(args) -> int:
    """Everything we can see, so an unknown deck can be identified."""
    print(f"transport backend: {transport.backend_name()}\n")
    seen = False
    for prof in DEVICES:
        for info in transport.enumerate_devices(prof.vendor_id, prof.product_id):
            seen = True
            mark = "vendor" if info.is_vendor_interface() else "      "
            tested = "" if prof.tested else "  [profile UNTESTED]"
            print(f"  {mark}  {info.vendor_id:04x}:{info.product_id:04x}  "
                  f"if={info.interface}  usage={info.usage_page:#06x}  "
                  f"{prof.name}{tested}")
            print(f"          {info.path}")
    if not seen:
        print("  no known deck attached.")
        print("\n  Known profiles:")
        for p in DEVICES:
            print(f"    {p.vendor_id:04x}:{p.product_id:04x}  {p.name}"
                  f"{'' if p.tested else '  (untested)'}")
        print("\n  If your deck is not listed, add a Profile in deck/devices.py"
              "\n  and send a pull request. See that file for what to fill in.")
    return 0 if seen else 1


def cmd_install(args) -> int:
    plat = platforms.current()
    exec_path = os.path.join(
        os.path.dirname(os.path.realpath(__file__)), "deck-daemon")

    ok1, msg1 = plat.install_udev(DEVICES, sudo=not args.no_sudo)
    print(("ok  " if ok1 else "FAIL") + "  " + msg1)
    ok2, msg2 = plat.install_autostart(exec_path)
    print(("ok  " if ok2 else "FAIL") + "  " + msg2)
    for n in plat.notes():
        print("note  " + n)
    return 0 if (ok1 and ok2) else 1


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("status"); p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_status)
    sub.add_parser("redraw").set_defaults(fn=cmd_redraw)
    sub.add_parser("reload").set_defaults(fn=cmd_reload)
    sub.add_parser("probe").set_defaults(fn=cmd_probe)
    p = sub.add_parser("install"); p.add_argument("--no-sudo", action="store_true")
    p.set_defaults(fn=cmd_install)

    args = ap.parse_args()
    if not getattr(args, "fn", None):
        ap.print_help()
        return 2
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
