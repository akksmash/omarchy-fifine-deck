#!/usr/bin/env bash
# One JSON line describing the Fifine D6: presence, daemon state, binding count.
present=false
for d in /sys/class/hidraw/hidraw*; do
  [ -e "$d" ] || continue
  case "$(readlink -f "$d")" in *:1.0/*3142:0060*) present=true ;; esac
done
daemon=$(systemctl --user is-active fifine-deckd 2>/dev/null)
keys=$(grep -c '^\[keys\.' "$HOME/.config/fifine-deck/keys.toml" 2>/dev/null || echo 0)
printf '{"present":%s,"daemon":"%s","keys":%s}\n' "$present" "${daemon:-unknown}" "${keys:-0}"
