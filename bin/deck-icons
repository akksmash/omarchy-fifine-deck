#!/usr/bin/env python3
"""Render key faces and push them to the deck.

    deck-icons                      draw from the live config
    deck-icons --preview DIR        render a contact sheet, touch no hardware
    deck-icons --prime commands     choose how hard to prime (see below)
    deck-icons --clear              blank every key
    deck-icons --dry-run            render and report sizes, send nothing

Priming walks the device through its lower modes so MOD 2 will render; without
it a cold deck lights its backlight and shows nothing. How much data that
priming pushes matters enormously, because the device stops accepting images
after a limited volume and only a power cycle resets it:

    commands     21KB   mode switches only          rendered nothing
    light       111KB   solid tiles, JPEG only
    jpeg        209KB   real artwork, JPEG only     best candidate
    full       1732KB   real artwork + BMP passes   renders (the default)

Always preview before pushing. It costs nothing, and the deck tolerates only a
few draw cycles per power cycle.
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))

from deck import config, render                      # noqa: E402
from deck.devices import default_profile             # noqa: E402
from deck.drivers import DeckNotFound, open_deck     # noqa: E402
from deck.drivers.crt import PRIME_STRATEGIES        # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True, description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--config", help="read keys from this file instead of the live one")
    ap.add_argument("--preview", metavar="DIR", help="write PNGs + a contact sheet, no hardware")
    ap.add_argument("--only", type=int, metavar="KEY", help="with --preview, render one key")
    ap.add_argument("--prime", choices=PRIME_STRATEGIES, default=None,
                    help="override the configured priming strategy")
    ap.add_argument("--sweeps", type=int, default=2,
                    help="times to walk the key set while drawing (default 2)")
    ap.add_argument("--brightness", type=int, default=None)
    ap.add_argument("--clear", action="store_true")
    ap.add_argument("--no-art", action="store_true", help="ignore generated artwork")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--reactivate-keys", action="store_true",
                    help="send MOD 1 after drawing, so the key daemon keeps "
                         "reporting. UNVERIFIED: it is not known whether MOD 1 "
                         "blanks the screens on this hardware.")
    args = ap.parse_args()

    if not render.have_magick():
        print("ImageMagick not found; cannot render tiles.", file=sys.stderr)
        return 2

    profile = default_profile()
    keys = {} if args.clear else config.load(args.config)
    if not keys and not args.clear:
        print("No key bindings configured. Run deck-editor, or edit keys.toml.",
              file=sys.stderr)

    use_art = not args.no_art

    # ---- preview: never touches the device -------------------------------
    if args.preview:
        os.makedirs(args.preview, exist_ok=True)
        wanted = [args.only] if args.only else list(profile.key_range)
        shots = []
        for k in wanted:
            shots.append(render.preview_png(k, keys.get(k, {}), profile,
                                            os.path.join(args.preview, f"pv{k}.png"),
                                            use_art=use_art))
        if len(shots) > 1:
            sheet = os.path.join(args.preview, "preview.png")
            render._run(["montage", *shots, "-tile", f"{profile.cols}x{profile.rows}",
                         "-geometry", "+5+5", "-background", "#2a2a2a", sheet])
            print(sheet)
        else:
            print(shots[0])
        return 0

    # ---- render ----------------------------------------------------------
    tiles = render.render_all(keys, profile, use_art=use_art)
    total = sum(len(v) for v in tiles.values())
    if args.dry_run:
        for k in profile.key_range:
            print(f"  {k:>2}  {len(tiles[k]):>5}B  {keys.get(k, {}).get('label', '')}")
        print(f"total {total / 1024:.1f}KB over {len(tiles)} tiles "
              f"(x{args.sweeps} sweeps = {total * args.sweeps / 1024:.1f}KB on the wire)")
        return 0

    # ---- push ------------------------------------------------------------
    try:
        dev = open_deck(profile)
    except DeckNotFound as e:
        print(e, file=sys.stderr)
        return 1

    with dev:
        if args.brightness is not None:
            dev.profile.brightness = args.brightness
        strategy = args.prime or config.load_settings(args.config)["prime"]
        dev.prime(strategy, tiles)
        if args.clear:
            dev.clear()
            print("cleared")
        else:
            dev.draw(tiles, sweeps=args.sweeps)
            print(f"drawn: {len(tiles)} tiles, {total * args.sweeps / 1024:.1f}KB "
                  f"on the wire, prime={strategy}, sweeps={args.sweeps}")
        if args.reactivate_keys:
            dev.activate_keys()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
